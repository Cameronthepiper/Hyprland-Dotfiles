[window]

opacity = 0.5

padding.x = 10
padding.y = 10

decorations = "none"

[colors.primary]
background = '#22261e'
foreground = '#dde0c0'

[colors.normal]
black   = '#22261e'
red     = '#cc6655'
green   = '#7fbf5f'
yellow  = '#a8943a'
blue    = '#6699cc'
magenta = '#cc99aa'
cyan    = '#55aaaa'
white   = '#dde0c0'

[colors.bright]
black   = '#303529'
red     = '#aa4433'
green   = '#a3c96b'
yellow  = '#c8ae50'
blue    = '#7aaedd'
magenta = '#ddaabc'
cyan    = '#6dbbbb'
white   = '#f5f0d8'

[font]
size = 7.0

[font.normal]
family = "JetBrainsMono Nerd Font Mono"
style = "Medium"

[font.bold]
family = "JetBrainsMono Nerd Font Mono"
style = "Bold"

[font.italic]
family = "JetBrainsMono Nerd Font Mono"
style = "Italic"

[font.bold_italic]
family = "JetBrainsMono Nerd Font Mono"
style = "Bold Italic"
